---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadForm from '../../components/LeadForm.astro';
import Icon from '../../components/Icon.astro';
import { programs, site } from '../../data/content';

export const getStaticPaths = (() =>
  programs.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }))) satisfies GetStaticPaths;

const { program } = Astro.props;

const meta = [
  { label: 'Длительность', value: program.hours },
  { label: 'Срок обучения', value: program.duration },
  { label: 'Формат', value: program.format },
  { label: 'Документ', value: program.doc },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: program.title,
  description: program.short,
  provider: {
    '@type': 'EducationalOrganization',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout
  title={`${program.title} — обучение в учебном центре «Специалист»`}
  description={program.short}
  jsonLd={jsonLd}
>
  <PageHero
    breadcrumbs={[
      { label: 'Главная', href: '/' },
      { label: 'Направления', href: '/directions/' },
      { label: program.title },
    ]}
    eyebrow={program.tag}
    title={program.title}
    description={program.short}
  >
    <div class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {meta.map((item) => (
        <div class="rounded-xl border border-[#dbe3ef] bg-white px-4 py-3">
          <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-[#7c8ba1]">{item.label}</p>
          <p class="mt-1 text-[13px] font-bold">{item.value}</p>
        </div>
      ))}
    </div>
  </PageHero>

  <section class="section-y">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[1fr_360px]">
      <div>
        <div class="mb-7 overflow-hidden rounded-2xl border border-[#e4e9f1]">
          <img src={program.image} alt={`Программа «${program.title}»`} width="1200" height="800" class="h-[260px] w-full object-cover sm:h-[340px]" />
        </div>
        <h2 class="font-display-a text-[clamp(1.5rem,2.6vw,2rem)] font-extrabold tracking-[-0.02em]">О программе</h2>
        <p class="mt-3 max-w-[68ch] text-[14.5px] leading-relaxed text-[#52627a]">{program.description}</p>

        <div class="mt-9 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-[#e4e9f1] bg-white p-5">
            <h3 class="text-[14px] font-extrabold">Для кого</h3>
            <ul class="mt-3 space-y-2">
              {program.audience.map((item) => (
                <li class="flex items-start gap-2 text-[13px] leading-relaxed text-[#52627a]">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#16a34a]" />{item}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl border border-[#e4e9f1] bg-white p-5">
            <h3 class="text-[14px] font-extrabold">Требования к слушателям</h3>
            <ul class="mt-3 space-y-2">
              {program.requirements.map((item) => (
                <li class="flex items-start gap-2 text-[13px] leading-relaxed text-[#52627a]">
                  <Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#1d4ed8]" />{item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <h2 class="mt-12 font-display-a text-[clamp(1.5rem,2.6vw,2rem)] font-extrabold tracking-[-0.02em]">Программа обучения</h2>
        <ol class="mt-4 space-y-3">
          {program.modules.map((module, index) => (
            <li class="flex gap-4 rounded-2xl border border-[#e4e9f1] bg-white p-5">
              <span class="font-display-a text-[13px] font-extrabold text-[#1d4ed8]">0{index + 1}</span>
              <div>
                <h3 class="text-[15px] font-extrabold">{module.title}</h3>
                <p class="mt-1 text-[13px] leading-relaxed text-[#5a6a80]">{module.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <h2 class="mt-12 font-display-a text-[clamp(1.5rem,2.6vw,2rem)] font-extrabold tracking-[-0.02em]">Чему научитесь</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-3">
          {program.outcomes.map((item) => (
            <li class="rounded-2xl border border-[#e4e9f1] bg-[#f8fafc] p-4 text-[13px] font-semibold leading-relaxed text-[#3c4a5f]">{item}</li>
          ))}
        </ul>
      </div>

      <aside class="lg:sticky lg:top-24">
        <div class="rounded-3xl border border-[#e4e9f1] bg-white p-6 shadow-[0_30px_70px_-40px_rgba(15,23,42,.35)]">
          <p class="text-[10.5px] font-bold uppercase tracking-[0.14em] text-[#7c8ba1]">Стоимость</p>
          <p class="mt-1 font-display-a text-[30px] font-extrabold leading-none tracking-tight">{program.price}</p>
          <p class="mt-1 text-[11.5px] text-[#7c8ba1]">{program.priceNote}</p>

          <dl class="mt-5 space-y-2.5 border-t border-[#eef1f6] pt-5 text-[12.5px]">
            <div class="flex items-center justify-between gap-3"><dt class="text-[#7c8ba1]">Документ</dt><dd class="text-right font-semibold">{program.doc}</dd></div>
            <div class="flex items-center justify-between gap-3"><dt class="text-[#7c8ba1]">Формат</dt><dd class="text-right font-semibold">{program.format}</dd></div>
            <div class="flex items-center justify-between gap-3"><dt class="text-[#7c8ba1]">Начало</dt><dd class="text-right font-semibold">по набору группы</dd></div>
          </dl>

          <a class="btn btn--primary btn--block mt-5" href="#lead">Оставить заявку</a>
          <a class="btn btn--secondary btn--block mt-2" href={site.phoneHref}>Позвонить: {site.phone}</a>
          <p class="mt-4 text-[10.5px] leading-relaxed text-[#94a3b8]">Демо-страница портфолио-проекта: цены и сроки приведены для примера.</p>
        </div>

        <div class="mt-4 rounded-2xl border border-[#e4e9f1] bg-[#f8fafc] p-5">
          <h3 class="text-[13px] font-extrabold">Нужна помощь с выбором?</h3>
          <p class="mt-1.5 text-[12px] leading-relaxed text-[#64748b]">Методист подскажет, подходит ли программа под вашу должность и отрасль.</p>
          <a class="mt-3 inline-flex items-center gap-2 text-[12px] font-bold text-[#1d4ed8]" href="#lead">Задать вопрос <Icon name="arrow" size={14} /></a>
        </div>
      </aside>
    </div>
  </section>

  <section id="lead" class="section-y bg-[#0b1626] text-white">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[1fr_460px]">
      <div>
        <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-[#8fb6ff]">Заявка на обучение</span>
        <h2 class="mt-2 max-w-[22ch] font-display-a text-[clamp(1.8rem,3.2vw,2.6rem)] font-extrabold leading-[1.08] tracking-[-0.02em]">
          Запишитесь на «{program.title}»
        </h2>
        <p class="mt-4 max-w-[46ch] text-[14.5px] leading-relaxed text-white/60">
          Оставьте контакты — согласуем даты, формат оплаты и пришлём договор. Для корпоративных групп подготовим предложение под количество сотрудников.
        </p>
        <p class="mt-6 text-[13px] text-white/50">Телефон: <a class="font-bold text-white" href={site.phoneHref}>{site.phone}</a></p>
        <p class="mt-1 text-[13px] text-white/50">Почта: <a class="font-bold text-white" href={site.emailHref}>{site.email}</a></p>
      </div>
      <LeadForm title="Оставить заявку" subtitle="Перезвоним и ответим на вопросы по программе." source={program.title} />
    </div>
  </section>
</BaseLayout>
