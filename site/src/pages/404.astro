---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/content';
---

<BaseLayout
  title="Страница не найдена — учебный центр «Специалист»"
  description="Такой страницы нет или она переехала. Вернитесь на главную или посмотрите направления обучения."
  noindex={true}
>
  <section class="page-hero">
    <div class="container-x flex min-h-[62vh] flex-col items-center justify-center py-16 text-center">
      <p class="font-display-a text-[clamp(4rem,12vw,8rem)] font-extrabold leading-none tracking-[-0.04em] text-[#1d4ed8]/15">404</p>
      <h1 class="mt-4 font-display-a text-[clamp(1.6rem,3.4vw,2.4rem)] font-extrabold tracking-[-0.02em]">Страница не найдена</h1>
      <p class="mt-3 max-w-[52ch] text-[14px] leading-relaxed text-[#52627a]">
        Возможно, ссылка устарела или страница ещё в разработке. Начните с главной или каталога программ.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a class="btn btn--primary" href="/">На главную <Icon name="arrow" size={16} /></a>
        <a class="btn btn--secondary" href="/directions/">Смотреть направления</a>
      </div>
      <p class="mt-10 text-[12px] text-[#7c8ba1]">Не нашли нужное? Позвоните: <a class="font-bold text-[#1d4ed8]" href={site.phoneHref}>{site.phone}</a></p>
    </div>
  </section>
</BaseLayout>
