---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { documents, site } from '../../data/content';

const anchorIds: Record<number, string | undefined> = { 0: 'license', 3: 'charter' };
---

<BaseLayout
  title="Документы — учебный центр «Специалист»"
  description="Лицензия на образовательную деятельность, устав, сведения об образовательной организации и политика обработки персональных данных."
>
  <PageHero
    eyebrow="Официальные документы"
    title="Документы"
    description="Лицензия, учредительные документы и обязательные сведения. Для демо-проекта документы обозначены как заглушки — в реальном проекте здесь были бы PDF-файлы."
    breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Документы' }]}
  />

  <section class="section-y">
    <div class="container-x">
      <div class="grid gap-4 sm:grid-cols-2">
        {documents.map((doc, index) => (
          <a
            id={anchorIds[index]}
            class="flex items-start gap-4 rounded-2xl border border-[#e4e9f1] bg-white p-6 transition hover:border-[#b9cdf0] hover:shadow-[0_24px_50px_-30px_rgba(29,78,216,.35)]"
            href={doc.href}
          >
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[#eef4ff] text-[#1d4ed8]"><Icon name="file" size={21} /></span>
            <span>
              <span class="block text-[15px] font-extrabold leading-snug">{doc.title}</span>
              <span class="mt-1.5 block text-[12.5px] leading-relaxed text-[#5a6a80]">{doc.description}</span>
              <span class="mt-3 inline-flex items-center gap-1.5 text-[10.5px] font-bold uppercase tracking-[0.1em] text-[#7c8ba1]">{doc.meta}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-10 flex flex-col items-start justify-between gap-5 rounded-3xl bg-[#0f1c33] p-8 text-white sm:flex-row sm:items-center">
        <div>
          <h2 class="font-display-a text-[clamp(1.4rem,2.6vw,1.9rem)] font-extrabold tracking-[-0.02em]">Сведения об образовательной организации</h2>
          <p class="mt-2 max-w-[56ch] text-[13.5px] leading-relaxed text-white/60">Обязательный раздел по требованиям Рособрнадзора: основные сведения, структура управления, образование и доступная среда.</p>
        </div>
        <a class="btn btn--primary shrink-0" href="/info-organization/">Открыть раздел <Icon name="arrow" size={16} /></a>
      </div>

      <div class="mt-6 rounded-2xl border border-[#e4e9f1] bg-[#f8fafc] p-5 text-[12px] leading-relaxed text-[#64748b]">
        Демо-проект: лицензия <span class="font-semibold">№ {site.license}</span> и реквизиты приведены для примера. В рабочей версии документы скачиваются в PDF и заверяются электронной подписью.
      </div>
    </div>
  </section>
</BaseLayout>
