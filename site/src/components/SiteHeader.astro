---
import Icon from './Icon.astro';
import { site, nav } from '../data/content';

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (!href.startsWith('/') || href.includes('#')) return false;
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-[#e4e9f1] bg-white/85 backdrop-blur-xl">
  <div class="container-x flex h-[76px] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-[#1d4ed8] text-lg font-extrabold text-white">С</span>
      <span class="leading-tight">
        <span class="block text-[15px] font-extrabold tracking-tight">Специалист</span>
        <span class="block text-[10.5px] font-medium uppercase tracking-[0.14em] text-[#64748b]">учебный центр</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a
            class:list={[
              'whitespace-nowrap text-[13px] font-semibold transition',
              isActive(item.href) ? 'text-[#1d4ed8]' : 'text-[#3c4a5f] hover:text-[#1d4ed8]',
            ]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-3">
      <a class="hidden whitespace-nowrap text-[14px] font-bold transition hover:text-[#1d4ed8] xl:block" href={site.phoneHref}>{site.phone}</a>
      <a class="hidden whitespace-nowrap rounded-full bg-[#1d4ed8] px-5 py-2.5 text-[13px] font-bold text-white shadow-[0_10px_30px_-12px_rgba(29,78,216,.8)] transition hover:bg-[#1a43b8] sm:inline-flex" href="/contacts/#lead">Оставить заявку</a>
      <button class="grid h-10 w-10 place-items-center rounded-xl border border-[#dfe5ee] lg:hidden" type="button" data-menu-toggle="#mobile-menu" aria-expanded="false" aria-label="Открыть меню" aria-controls="mobile-menu">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu-panel" data-menu-panel>
  <div class="flex items-center justify-between">
    <span class="text-[15px] font-extrabold text-[#0c1729]">Меню</span>
    <button class="grid h-10 w-10 place-items-center rounded-xl border border-[#dfe5ee] text-[#0c1729]" type="button" data-menu-close aria-label="Закрыть меню">
      <Icon name="x" size={18} />
    </button>
  </div>
  <nav class="flex flex-col gap-1" aria-label="Мобильная навигация">
    {nav.map((item) => <a class="rounded-xl px-3 py-3 text-[15px] font-semibold text-[#3c4a5f] hover:bg-[#eef4ff]" href={item.href} data-menu-close>{item.label}</a>)}
    <a class="rounded-xl px-3 py-3 text-[15px] font-semibold text-[#1d4ed8]" href="/contacts/#lead" data-menu-close>Оставить заявку</a>
  </nav>
  <div class="mt-auto flex flex-col gap-2 border-t border-[#e4e9f1] pt-4">
    <a class="text-[15px] font-extrabold text-[#0c1729]" href={site.phoneHref}>{site.phone}</a>
    <a class="text-[13px] font-semibold text-[#64748b]" href={site.emailHref}>{site.email}</a>
  </div>
</div>
