---
import Icon from './Icon.astro';
import type { Program } from '../data/content';

interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<a
  class="group flex flex-col overflow-hidden rounded-2xl border border-[#e4e9f1] bg-white transition duration-200 hover:-translate-y-1 hover:border-[#b9cdf0] hover:shadow-[0_26px_55px_-26px_rgba(29,78,216,.4)]"
  href={`/directions/${program.slug}/`}
>
  <div class="relative h-[190px] w-full overflow-hidden bg-[#eef4ff]">
    <img
      src={program.image}
      alt={`Программа «${program.title}»`}
      width="1200"
      height="800"
      loading="lazy"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
    />
    <span class="absolute left-4 top-4 rounded-full bg-white/95 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.1em] text-[#1d4ed8]">{program.tag}</span>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-[18px] font-extrabold tracking-[-0.01em]">{program.title}</h3>
    <p class="mt-2 flex-1 text-[13px] leading-relaxed text-[#5a6a80]">{program.short}</p>
    <span class="mt-5 flex items-center justify-between border-t border-[#eef1f6] pt-4 text-[11.5px] font-semibold text-[#52627a]">
      <span>{program.hours} · {program.price}</span>
      <Icon name="arrow" size={16} class="text-[#1d4ed8] transition group-hover:translate-x-1" />
    </span>
  </div>
</a>
