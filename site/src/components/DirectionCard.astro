---
import Icon from './Icon.astro';
import type { Program } from '../data/content';

interface Props {
  program: Program;
}

const { program } = Astro.props;
---

<a
  class="group flex flex-col rounded-2xl border border-[#e4e9f1] bg-white p-6 transition duration-200 hover:-translate-y-1 hover:border-[#b9cdf0] hover:shadow-[0_26px_55px_-26px_rgba(29,78,216,.4)]"
  href={`/directions/${program.slug}/`}
>
  <span class="grid h-11 w-11 place-items-center rounded-xl bg-[#eef4ff] text-[#1d4ed8]"><Icon name={program.icon} size={22} /></span>
  <span class="mt-5 text-[10px] font-bold uppercase tracking-[0.12em] text-[#7c8ba1]">{program.tag}</span>
  <h3 class="mt-1.5 text-[18px] font-extrabold tracking-[-0.01em]">{program.title}</h3>
  <p class="mt-2 flex-1 text-[13px] leading-relaxed text-[#5a6a80]">{program.short}</p>
  <span class="mt-5 flex items-center justify-between border-t border-[#eef1f6] pt-4 text-[11.5px] font-semibold text-[#52627a]">
    <span>{program.hours} · {program.price}</span>
    <Icon name="arrow" size={16} class="text-[#1d4ed8] transition group-hover:translate-x-1" />
  </span>
</a>
